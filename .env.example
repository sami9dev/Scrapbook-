# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/scraper_db

# Request & Discovery Controls
REQUEST_TIMEOUT=15000
MAX_REDIRECTS=10
MAX_RETRIES=2
CONCURRENCY=3

# Identification & Safety
USER_AGENT=AuthorizedMetadataScraper/1.0

# Optional Domain Allowlist (comma-separated, e.g., "example-authorized-site.test,provider.example,gdflix.example")
# If empty or not set, SSRF protection against private/internal IP ranges still strictly applies.
ALLOWED_DOMAINS=example-authorized-site.test,provider.example,gdflix.example,localhost,127.0.0.1
