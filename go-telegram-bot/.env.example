# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Maximum concurrent workers running parallel jobs
WORKER_CONCURRENCY=10

# Cache Time-to-Live in minutes (0 for no expiration)
CACHE_TTL_MINUTES=1440

# Local scraper service endpoint (optional, for browser-backed challenges)
LOCAL_RESOLVER_API=http://localhost:3000/api/resolve-link

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=45
